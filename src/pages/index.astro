---
import { Image } from 'astro:assets';
import Base from '../layouts/Base.astro';
import BrandMark from '../components/BrandMark.astro';
import TourCard from '../components/TourCard.astro';
import ProductCard from '../components/ProductCard.astro';
import { href } from '../lib/paths';
import { islandBlurbs, islandLabels, tours, toursForIsland } from '../data/tours';
import { products } from '../data/products';

import heroImage from '../assets/generated/hero-south-island-ridgeline.png';
import tussockRidge from '../assets/scenes/tussock-ridge.jpg';
import valleyDawn from '../assets/scenes/valley-dawn.jpg';
import braidedRiver from '../assets/scenes/braided-river.jpg';
import merchBoard from '../assets/generated/merchandise-concept-board.png';
import duffelDetail from '../assets/products/duffel-detail.png';
import enamelMug from '../assets/products/enamel-mug.png';

const featured = tours.filter((tour) => tour.featured);
const featuredProducts = products.filter((product) => product.featured).slice(0, 4);

const values = [
  {
    number: '01',
    title: 'A guide sets the day',
    body: 'The journey concepts put a guide in charge of the route, the pace and the decision to turn back when the country changes.',
  },
  {
    number: '02',
    title: 'Access comes first',
    body: 'No itinerary makes sense until access and permissions are sorted. The site names no real property, block or access point.',
  },
  {
    number: '03',
    title: 'Know when to leave it',
    body: 'Identification, angle, backstop and recovery ground all matter. If the situation is wrong, the fictional plan is to walk away.',
  },
  {
    number: '04',
    title: 'Game care is part of the day',
    body: 'The journey outlines treat recovery and game care as field work, not as a footnote after the hunt.',
  },
];

const notes = [
  {
    title: 'A quiet morning still counts',
    body:
      'Some days produce only weather, a long sit and a better read on the next basin. The journey copy leaves room for that.',
  },
  {
    title: 'Learning is a valid outcome',
    body:
      'The foundation journey is built around fieldcraft and good decisions. Taking an animal is not presented as the only measure of the week.',
  },
  {
    title: 'The table matters',
    body:
      'A warm room, dry gear and one shared meal give the off-hill hours a proper place in each fictional itinerary.',
  },
];

const atmosphere = [
  {
    title: 'The lodges',
    body: 'The lodge concept is simple: warm rooms, dry gear and enough space for a small party before an early start.',
    image: valleyDawn,
    alt: 'Dawn light spilling into a high-country valley below the ranges.',
  },
  {
    title: 'The long table',
    body: 'One kitchen and one table. A solid breakfast before first light, then a shared meal when everyone is back inside.',
    image: enamelMug,
    alt: 'Bone enamel camp mug with a forest green rim.',
    contain: true,
  },
  {
    title: 'The guides',
    body: 'The guides in this fictional house are there to read the ground and say plainly when the day needs a different plan.',
    image: tussockRidge,
    alt: 'Guided party moving along a tussock ridge in evening light.',
  },
];
---

<Base
  title="Harry's Hunts — New Zealand Field Journeys"
  description="Harry's Hunts is a fictional demonstration of small, guide-led New Zealand hunting journeys, with an interactive planner and mock field-kit store."
  pageId="home"
  padTop={false}
>
  <!-- ------------------------------------------------------------- hero -->
  <section class="hh-hero hh-on-dark" aria-labelledby="hero-title">
    <Image
      class="hh-hero__image"
      src={heroImage}
      alt="Three guided walkers following a tussock ridge above a braided river at dawn, with snow on the Southern Alps beyond."
      widths={[720, 1100, 1672]}
      sizes="100vw"
      loading="eager"
      fetchpriority="high"
    />
    <div class="hh-hero__scrim"></div>

    <div class="hh-hero__content hh-container">
      <BrandMark variant="mark" height="clamp(3.2rem, 7vw, 5rem)" decorative class="hh-hero__mark" />
      <p class="hh-hero__eyebrow">New Zealand Field Journeys</p>
      <h1 id="hero-title" class="hh-hero__title">
        The country sets<br />the pace.
      </h1>
      <p class="hh-hero__lede">
        Small, guide-led hunting journeys across both islands, from volcanic plateau to alpine
        basin. The ground decides how the day goes.
      </p>
      <div class="hh-hero__actions">
        <a class="hh-button hh-button--on-dark" href={href('/book/')}>Try the journey planner</a>
        <a class="hh-button hh-button--outline-dark" href={href('/journeys/')}>Browse all five journeys</a>
      </div>
      <p class="hh-hero__note">
        Fictional operator, working demo. Nothing can be booked or bought.
      </p>
    </div>

    <a class="hh-hero__scroll" href="#story" aria-label="Skip to the Harry's Hunts story">
      <span aria-hidden="true"></span>
    </a>
  </section>

  <!-- -------------------------------------------------------- brand story -->
  <section class="hh-section" id="story" aria-labelledby="story-title">
    <div class="hh-container hh-story hh-reveal">
      <div class="hh-story__lead">
        <p class="hh-eyebrow">A fictional New Zealand outfitter</p>
        <h2 id="story-title">
          A house built on <em>patience</em>, not trophies.
        </h2>
      </div>
      <div class="hh-story__body hh-stack-m">
        <p class="hh-lede">
          Harry&rsquo;s Hunts is a made-up outfit for people who care as much about the country and the
          decisions as they do about the hunt.
        </p>
        <p>
          The catalogue has five journeys, each built around a kind of country: volcanic gullies,
          tight eastern bush, alpine bluffs or the long sightlines above a braided river.
        </p>
        <p>
          The fictional parties are small and the guide makes the call when the weather or ground
          changes. A week that yields only miles walked and country learned is still treated honestly.
        </p>
        <p>
          <a class="hh-link" href={href('/about/')}>Read about the concept</a>
        </p>
      </div>
    </div>
  </section>

  <!-- ---------------------------------------------------- featured journeys -->
  <section class="hh-section hh-section--sunken" aria-labelledby="journeys-title">
    <div class="hh-container">
      <header class="hh-sectionhead hh-reveal">
        <div>
          <p class="hh-eyebrow">Featured journeys</p>
          <h2 id="journeys-title">Four ways into the country</h2>
        </div>
        <p class="hh-sectionhead__aside">
          Every journey is fictional and every figure is indicative. Nothing here can be booked.
        </p>
      </header>

      <div class="hh-tourgrid hh-reveal">
        {
          featured.map((tour, index) => (
            <TourCard tour={tour} emphasis={index === 0 ? 'feature' : 'default'} />
          ))
        }
      </div>

      <p class="hh-sectionfoot hh-reveal">
        <a class="hh-button hh-button--secondary" href={href('/journeys/')}>
          View the full catalogue
        </a>
      </p>
    </div>
  </section>

  <!-- -------------------------------------------------------- two islands -->
  <section class="hh-section hh-section--inverse hh-on-dark" aria-labelledby="islands-title">
    <div class="hh-container">
      <header class="hh-sectionhead hh-reveal">
        <div>
          <p class="hh-eyebrow">Two islands</p>
          <h2 id="islands-title">Two islands, two kinds of country</h2>
        </div>
      </header>

      <div class="hh-islands hh-reveal">
        {
          (['north', 'south'] as const).map((island) => {
            const blurb = islandBlurbs[island];
            const count = toursForIsland(island).length;
            return (
              <article class="hh-island">
                <p class="hh-island__label">{islandLabels[island]}</p>
                <h3 class="hh-island__title">{blurb.heading}</h3>
                <p class="hh-island__body">{blurb.body}</p>
                <ul class="hh-island__notes">
                  {blurb.notes.map((note) => (
                    <li>{note}</li>
                  ))}
                </ul>
                <a class="hh-link hh-island__link" href={href(`/journeys/?island=${island}`)}>
                  {count} {count === 1 ? 'journey' : 'journeys'} in the {islandLabels[island]}
                </a>
              </article>
            );
          })
        }
      </div>
    </div>
  </section>

  <!-- ------------------------------------------------------- field values -->
  <section class="hh-section" aria-labelledby="values-title">
    <div class="hh-container">
      <header class="hh-sectionhead hh-reveal">
        <div>
          <p class="hh-eyebrow">Field values</p>
          <h2 id="values-title">What shapes each journey</h2>
        </div>
        <p class="hh-sectionhead__aside">
          These are principles for a fictional operator, not guidance for a real hunt.
        </p>
      </header>

      <ol class="hh-values hh-reveal">
        {
          values.map((value) => (
            <li class="hh-value">
              <span class="hh-value__number" aria-hidden="true">
                {value.number}
              </span>
              <h3 class="hh-value__title">{value.title}</h3>
              <p class="hh-value__body">{value.body}</p>
            </li>
          ))
        }
      </ol>
    </div>
  </section>

  <!-- --------------------------------------------------------- atmosphere -->
  <section class="hh-section hh-section--sunken" aria-labelledby="atmosphere-title">
    <div class="hh-container">
      <header class="hh-sectionhead hh-reveal">
        <div>
          <p class="hh-eyebrow">Off the hill</p>
          <h2 id="atmosphere-title">Half of it happens indoors</h2>
        </div>
      </header>

      <div class="hh-atmosphere hh-reveal">
        {
          atmosphere.map((panel) => (
            <article class="hh-atmos">
              <div class:list={['hh-atmos__media', panel.contain && 'hh-atmos__media--contain']}>
                <Image
                  src={panel.image}
                  alt={panel.alt}
                  widths={[320, 520, 760]}
                  sizes="(min-width: 60rem) 24rem, 92vw"
                  loading="lazy"
                  decoding="async"
                />
              </div>
              <h3 class="hh-atmos__title">{panel.title}</h3>
              <p class="hh-atmos__body">{panel.body}</p>
            </article>
          ))
        }
      </div>
    </div>
  </section>

  <!-- ------------------------------------------------------- editorial notes -->
  <section class="hh-section" aria-labelledby="notes-title">
    <div class="hh-container">
      <header class="hh-sectionhead hh-reveal">
        <div>
          <p class="hh-eyebrow">A note on outcomes</p>
          <h2 id="notes-title">What the journeys make room for</h2>
        </div>
        <p class="hh-sectionhead__aside">
          Harry&rsquo;s Hunts has no guests or testimonials. These are editorial notes for the concept.
        </p>
      </header>

      <div class="hh-notes hh-reveal">
        {
          notes.map((note) => (
            <article class="hh-note">
              <h3 class="hh-note__name">{note.title}</h3>
              <p>{note.body}</p>
            </article>
          ))
        }
      </div>
    </div>
  </section>

  <!-- ------------------------------------------------------------- store -->
  <section class="hh-section hh-section--sunken" aria-labelledby="store-title">
    <div class="hh-container">
      <div class="hh-storeteaser hh-reveal">
        <div class="hh-storeteaser__media">
          <Image
            src={merchBoard}
            alt="Concept sheet showing the Harry's Hunts field kit: wool cap, merino quarter-zip, waxed canvas duffel, enamel mug and field notebook."
            widths={[420, 680, 1024]}
            sizes="(min-width: 60rem) 26rem, 92vw"
            loading="lazy"
            decoding="async"
          />
          <Image
            class="hh-storeteaser__inset"
            src={duffelDetail}
            alt="Close-up of the stamped leather patch with water beading on waxed canvas."
            widths={[240, 420]}
            sizes="12rem"
            loading="lazy"
            decoding="async"
          />
        </div>

        <div class="hh-storeteaser__body hh-stack-m">
          <p class="hh-eyebrow">The field kit</p>
          <h2 id="store-title">Five useful-looking things</h2>
          <p class="hh-lede">
            Wool, merino, waxed canvas, enamel and paper. A restrained fictional kit, with the mark
            kept small.
          </p>
          <p>
            The store is a working mockup with variants, a cart and a delivery estimate. Checkout
            finishes with a demo confirmation; it never accepts payment details or creates an order.
          </p>
          <p>
            <a class="hh-button" href={href('/shop/')}>Browse the store</a>
          </p>
        </div>
      </div>

      <div class="hh-productgrid hh-reveal">
        {featuredProducts.map((product) => <ProductCard product={product} />)}
      </div>
    </div>
  </section>

  <!-- --------------------------------------------------------- closing cta -->
  <section class="hh-cta hh-on-dark" aria-labelledby="cta-title">
    <Image
      class="hh-cta__image"
      src={braidedRiver}
      alt=""
      widths={[720, 1100, 1400]}
      sizes="100vw"
      loading="lazy"
      decoding="async"
    />
    <div class="hh-cta__scrim"></div>
    <div class="hh-container hh-cta__content hh-reveal">
      <p class="hh-eyebrow">Build an outline</p>
      <h2 id="cta-title">Start with the week you have.</h2>
      <p class="hh-lede">
        Choose an island, terrain, season and party, then read the choices back as one outline. The
        demo stops there: nothing is sent or reserved.
      </p>
      <div class="hh-cta__actions">
        <a class="hh-button hh-button--on-dark" href={href('/book/')}>Try the journey planner</a>
        <a class="hh-button hh-button--outline-dark" href={href('/about/#contact')}>Try the demo enquiry</a>
      </div>
    </div>
  </section>
</Base>

<style>
  /* ------------------------------------------------------------------ hero */
  .hh-hero {
    position: relative;
    display: grid;
    align-items: end;
    min-height: min(92svh, 54rem);
    padding-block: var(--hh-space-3xl) var(--hh-space-2xl);
    overflow: clip;
    background: var(--hh-forest-950);
    isolation: isolate;
  }

  .hh-hero :global(.hh-hero__image) {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: 62% 50%;
    z-index: -2;
    animation: hh-heroin 1.6s var(--hh-ease-out) both;
  }

  @keyframes hh-heroin {
    from {
      opacity: 0;
      transform: scale(1.05);
    }
    to {
      opacity: 1;
      transform: none;
    }
  }

  .hh-hero__scrim {
    position: absolute;
    inset: 0;
    z-index: -1;
    background:
      linear-gradient(
        to top,
        rgb(8 18 13 / 0.92) 0%,
        rgb(8 18 13 / 0.72) 34%,
        rgb(8 18 13 / 0.25) 66%,
        rgb(8 18 13 / 0.4) 100%
      ),
      linear-gradient(to right, rgb(8 18 13 / 0.6), transparent 62%);
  }

  .hh-hero__content {
    position: relative;
    max-width: 46rem;
    margin-inline: 0;
    padding-inline: var(--hh-gutter);
    animation: hh-rise 900ms var(--hh-ease-out) 120ms both;
  }

  .hh-hero :global(.hh-hero__mark) {
    --hh-brandmark-ink: var(--hh-bone-50);
    --hh-brandmark-ridge: var(--hh-bone-50);
    --hh-brandmark-antler: var(--hh-brass-300);
    margin-bottom: var(--hh-space-s);
  }

  .hh-hero__eyebrow {
    font-size: var(--hh-step--2);
    font-weight: 500;
    letter-spacing: var(--hh-tracking-eyebrow);
    text-transform: uppercase;
    color: var(--hh-brass-300);
    margin-bottom: var(--hh-space-xs);
  }

  .hh-hero__title {
    font-size: var(--hh-step-6);
    line-height: 0.98;
    color: var(--hh-bone-50);
    text-shadow: 0 2px 30px rgb(8 18 13 / 0.5);
  }

  .hh-hero__lede {
    margin-top: var(--hh-space-m);
    max-width: 40ch;
    font-size: var(--hh-step-1);
    color: var(--hh-bone-200);
  }

  .hh-hero__actions {
    display: flex;
    flex-wrap: wrap;
    gap: var(--hh-space-2xs);
    margin-top: var(--hh-space-l);
  }

  .hh-hero__note {
    margin-top: var(--hh-space-m);
    font-size: var(--hh-step--2);
    letter-spacing: 0.06em;
    text-transform: uppercase;
    color: color-mix(in srgb, var(--hh-bone-100) 66%, transparent);
  }

  .hh-hero__scroll {
    position: absolute;
    left: 50%;
    bottom: var(--hh-space-s);
    translate: -50% 0;
    width: 2.5rem;
    height: 2.5rem;
    display: grid;
    place-items: center;
    border-radius: 50%;
    border: 1px solid var(--hh-line-inverse);
  }

  .hh-hero__scroll span {
    width: 0.5rem;
    height: 0.5rem;
    border-right: 1.5px solid var(--hh-bone-100);
    border-bottom: 1.5px solid var(--hh-bone-100);
    rotate: 45deg;
    translate: 0 -2px;
    animation: hh-nudge 2.4s var(--hh-ease) infinite;
  }

  @keyframes hh-nudge {
    0%,
    100% {
      translate: 0 -3px;
    }
    50% {
      translate: 0 1px;
    }
  }

  @media (max-width: 40rem) {
    .hh-hero__scroll {
      display: none;
    }
  }

  /* --------------------------------------------------------- section heads */
  .hh-sectionhead {
    display: grid;
    gap: var(--hh-space-s);
    align-items: end;
    margin-bottom: var(--hh-space-xl);
  }

  .hh-sectionhead > div > h2 {
    margin-top: var(--hh-space-2xs);
  }

  .hh-sectionhead__aside {
    font-size: var(--hh-step--1);
    color: var(--hh-ink-muted);
    max-width: 42ch;
  }

  .hh-section--inverse .hh-sectionhead__aside {
    color: var(--hh-ink-inverse-muted);
  }

  @media (min-width: 56rem) {
    .hh-sectionhead {
      grid-template-columns: minmax(0, 1.4fr) minmax(0, 1fr);
      gap: var(--hh-space-2xl);
    }

    .hh-sectionhead__aside {
      justify-self: end;
      text-align: right;
    }
  }

  .hh-sectionfoot {
    margin-top: var(--hh-space-xl);
    text-align: center;
  }

  /* --------------------------------------------------------------- story */
  .hh-story {
    display: grid;
    gap: var(--hh-space-l);
  }

  .hh-story__lead h2 {
    margin-top: var(--hh-space-2xs);
  }

  .hh-story__lead em {
    font-style: italic;
    color: var(--hh-forest-600);
  }

  @media (min-width: 56rem) {
    .hh-story {
      grid-template-columns: minmax(0, 1fr) minmax(0, 1.15fr);
      gap: var(--hh-space-3xl);
    }

    .hh-story__body {
      padding-left: var(--hh-space-l);
      border-left: 1px solid var(--hh-line);
    }
  }

  /* ----------------------------------------------------------- tour grid */
  .hh-tourgrid {
    display: grid;
    gap: var(--hh-space-m);
    grid-template-columns: repeat(auto-fit, minmax(min(19rem, 100%), 1fr));
  }

  @media (min-width: 64rem) {
    .hh-tourgrid {
      grid-template-columns: repeat(3, minmax(0, 1fr));
    }

    .hh-tourgrid > :global(.hh-tourcard--feature) {
      grid-column: span 3;
    }

    .hh-tourgrid > :global(.hh-tourcard--feature) :global(.hh-tourcard__media) {
      aspect-ratio: 21 / 8;
    }
  }

  /* -------------------------------------------------------------- islands */
  .hh-islands {
    display: grid;
    gap: var(--hh-space-l);
  }

  @media (min-width: 52rem) {
    .hh-islands {
      grid-template-columns: repeat(2, minmax(0, 1fr));
      gap: 0;
    }

    .hh-island + .hh-island {
      padding-left: var(--hh-space-2xl);
      border-left: 1px solid var(--hh-line-inverse);
    }

    .hh-island:first-child {
      padding-right: var(--hh-space-2xl);
    }
  }

  .hh-island__label {
    font-family: var(--hh-font-display);
    font-size: var(--hh-step-1);
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--hh-brass-300);
  }

  .hh-island__title {
    margin-block: var(--hh-space-2xs) var(--hh-space-xs);
    font-size: var(--hh-step-2);
  }

  .hh-island__body {
    color: var(--hh-ink-inverse-muted);
    max-width: 46ch;
  }

  .hh-island__notes {
    list-style: none;
    padding: 0;
    margin: var(--hh-space-m) 0;
    display: grid;
    gap: 0.5rem;
  }

  .hh-island__notes li {
    position: relative;
    padding-left: 1.5rem;
    font-size: var(--hh-step--1);
    color: var(--hh-bone-200);
  }

  .hh-island__notes li::before {
    content: '';
    position: absolute;
    left: 0;
    top: 0.62em;
    width: 0.7rem;
    height: 1px;
    background: var(--hh-brass-500);
  }

  .hh-island__link {
    font-size: var(--hh-step--1);
    letter-spacing: var(--hh-tracking-wide);
    text-transform: uppercase;
  }

  /* --------------------------------------------------------------- values */
  .hh-values {
    list-style: none;
    padding: 0;
    margin: 0;
    display: grid;
    gap: var(--hh-space-l);
    grid-template-columns: repeat(auto-fit, minmax(min(15rem, 100%), 1fr));
    counter-reset: value;
  }

  .hh-value {
    padding-top: var(--hh-space-s);
    border-top: 2px solid var(--hh-forest-800);
  }

  .hh-value__number {
    display: block;
    font-family: var(--hh-font-display);
    font-size: var(--hh-step-2);
    color: var(--hh-brass-500);
    margin-bottom: var(--hh-space-2xs);
  }

  .hh-value__title {
    font-size: var(--hh-step-1);
    margin-bottom: var(--hh-space-2xs);
  }

  .hh-value__body {
    font-size: var(--hh-step--1);
    color: var(--hh-ink-muted);
  }

  /* ----------------------------------------------------------- atmosphere */
  .hh-atmosphere {
    display: grid;
    gap: var(--hh-space-l);
    grid-template-columns: repeat(auto-fit, minmax(min(17rem, 100%), 1fr));
  }

  .hh-atmos__media {
    position: relative;
    aspect-ratio: 4 / 3;
    border-radius: var(--hh-radius-m);
    overflow: clip;
    background: var(--hh-forest-900);
    margin-bottom: var(--hh-space-s);
  }

  .hh-atmos__media :global(img) {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .hh-atmos__media--contain {
    background: var(--hh-bone-200);
  }

  .hh-atmos__media--contain :global(img) {
    padding: var(--hh-space-s);
    object-fit: contain;
    mix-blend-mode: multiply;
  }

  .hh-atmos__title {
    font-size: var(--hh-step-2);
    margin-bottom: var(--hh-space-2xs);
  }

  .hh-atmos__body {
    font-size: var(--hh-step--1);
    color: var(--hh-ink-muted);
  }

  /* ---------------------------------------------------------------- notes */
  .hh-notes {
    display: grid;
    gap: var(--hh-space-m);
    grid-template-columns: repeat(auto-fit, minmax(min(17rem, 100%), 1fr));
  }

  .hh-note {
    margin: 0;
    padding: var(--hh-space-m);
    background: var(--hh-surface-raised);
    border: 1px solid var(--hh-line);
    border-top: 2px solid var(--hh-brass-500);
    border-radius: var(--hh-radius-m);
