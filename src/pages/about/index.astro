---
import { Image } from 'astro:assets';
import Base from '../../layouts/Base.astro';
import { href } from '../../lib/paths';
import { tours } from '../../data/tours';

import brandBoard from '../../assets/generated/brand-concept-board.png';
import valleyDawn from '../../assets/scenes/valley-dawn.jpg';

const contents = [
  { id: 'values', label: 'Field values' },
  { id: 'guides', label: 'Guides and lodges' },
  { id: 'contact', label: 'Contact' },
  { id: 'demonstration', label: 'How the demo works' },
  { id: 'assets', label: 'Asset provenance' },
];

const fieldValues = [
  {
    title: 'Access before itinerary',
    body: 'A credible trip would begin with lawful access and the right permissions. This fictional site names no property, concession, block or access point.',
  },
  {
    title: 'The guide makes the call',
    body: 'In the journey concepts, the guide reads the route, wind and conditions, explains the reasoning, and decides when the day needs to change.',
  },
  {
    title: 'Conditions can rewrite the day',
    body: 'Weather, rivers and alpine ground do not follow brochure copy. The itineraries leave room to turn back or use a reserve day.',
  },
  {
    title: 'Identify, then decide',
    body: 'The copy puts identification, angle, backstop and recovery ground ahead of taking a shot. A wrong situation ends the stalk.',
  },
  {
    title: 'Game care belongs in the plan',
    body: 'Recovery and game care are treated as part of the field day. The site makes no claim about real processing, distribution or facilities.',
  },
  {
    title: 'Walking away is allowed',
    body: 'Bad weather, rising water, tired legs or the wrong animal can all stop the day. The fictional itineraries treat that as sound judgement, not a failed outing.',
  },
];

const whatIsReal = [
  'The website, including its pages, components and deployment.',
  'The visual system: colour, type, spacing and reusable interface patterns.',
  'The browser interactions in the planner, store, cart and checkout.',
  'The accessibility features, including labelled controls, focus handling and reduced-motion support.',
  'The repeatable image process used to make product tiles and journey scenes from three source boards.',
];

const whatIsInvented = [
  'Harry, the operator, the guides and every place to stay.',
  'All five journeys, including their itineraries and inclusions.',
  'Every indicative price and delivery figure.',
  'The field-kit products, options and stock states.',
  'The confirmation references produced by the planner and checkout.',
  'Any suggestion of availability. Nothing can be reserved, ordered or bought.',
];
---

<Base
  title="About Harry's Hunts"
  description="The idea behind fictional outfitter Harry's Hunts, its field principles, demonstration enquiry and a clear account of what is real and invented."
  pageId="about"
>
  <!-- ------------------------------------------------------- page header -->
  <section class="hh-section hh-section--tight" aria-labelledby="about-title">
    <div class="hh-container hh-pagehead">
      <div class="hh-pagehead__lead hh-stack-m">
        <p class="hh-eyebrow">About the concept</p>
        <h1 id="about-title">A small outfitter, made up in full.</h1>
        <p class="hh-lede">
          Harry&rsquo;s Hunts is a fictional New Zealand hunting-tour brand. The idea is deliberately
          narrow: five small, guide-led journeys shaped around distinct kinds of country.
        </p>
        <p>
          That narrow catalogue gives the site its character. Parties stay small, the pace is set by
          the ground, and the copy leaves room for weather, changed plans and days when no animal is taken.
        </p>
        <p>
          The voice aims to be direct about the awkward parts: mountain weather changes, animals do
          not appear on cue, and real licensing, access and safety questions belong with real New
          Zealand authorities and qualified operators.
        </p>
      </div>

      <nav class="hh-toc" aria-labelledby="toc-title" data-testid="about-contents">
        <h2 id="toc-title" class="hh-toc__title">On this page</h2>
        <ul>
          {
            contents.map((entry) => (
              <li>
                <a href={href(`#${entry.id}`)}>{entry.label}</a>
              </li>
            ))
          }
        </ul>
      </nav>
    </div>
  </section>

  <!-- ------------------------------------------------------- field values -->
  <section
    class="hh-section hh-section--sunken"
    id="values"
    aria-labelledby="values-title"
    data-testid="about-values"
  >
    <div class="hh-container">
      <header class="hh-sectionhead hh-reveal">
        <div>
          <p class="hh-eyebrow">Field values</p>
          <h2 id="values-title">Six principles behind the journeys</h2>
        </div>
        <p class="hh-sectionhead__aside">
          These are editorial principles for the demonstration, not instructions for a real trip,
          permit application or safety plan.
        </p>
      </header>

      <div class="hh-valuegrid hh-reveal">
        {
          fieldValues.map((value) => (
            <article class="hh-valuecard">
              <h3 class="hh-valuecard__title">{value.title}</h3>
              <p class="hh-valuecard__body">{value.body}</p>
            </article>
          ))
        }
      </div>
    </div>
  </section>

  <!-- -------------------------------------------------- guides and lodges -->
  <section class="hh-section" id="guides" aria-labelledby="guides-title" data-testid="about-guides">
    <div class="hh-container">
      <header class="hh-sectionhead hh-reveal">
        <div>
          <p class="hh-eyebrow">Guides and places to stay</p>
          <h2 id="guides-title">How the fictional operation is framed</h2>
        </div>
        <p class="hh-sectionhead__aside">
          No guide, lodge, hut or property described here is real.
        </p>
      </header>

      <div class="hh-guides hh-reveal">
        <figure class="hh-guides__figure">
          <Image
            src={valleyDawn}
            alt="Dawn light reaching into a high-country valley, with cloud lying along the ranges behind."
            widths={[396, 594, 792]}
            sizes="(min-width: 60rem) 26rem, 92vw"
            loading="lazy"
            decoding="async"
          />
          <figcaption>
            First light in the valley. Derived from the AI-generated South Island board &mdash; see
            <a class="hh-link" href={href('#assets')}>asset provenance</a>.
          </figcaption>
        </figure>

        <div class="hh-guides__body hh-stack-m">
          <h3>The guides</h3>
          <p>
            The concept puts the guide at the centre of the day. They read the ground, set the pace,
            explain their calls and change the plan when the conditions demand it. No fictional
            biography or credential is offered as proof of real experience.
          </p>
          <p>
            The useful trait is judgement, including the willingness to say no to a route, a shot or
            a whole day. That restraint runs through every journey outline.
          </p>

          <h3>The lodges and the huts</h3>
          <p>
            The accommodation concepts range from a timber lodge to backcountry huts. They are plain
            and practical on the page: somewhere warm, somewhere to dry gear and a bed suited to the
            country. None represents a real building or booking.
          </p>

          <h3>The long table</h3>
          <p>
            The long table is the off-hill centre of the brand: one meal, wet gear drying elsewhere,
            and coffee ready before the first party heads out. It gives the journeys warmth without
            pretending any guest has actually sat there.
          </p>
        </div>
      </div>
    </div>
  </section>

  <!-- ------------------------------------------------------------ contact -->
  <section
    class="hh-section hh-section--sunken"
    id="contact"
    aria-labelledby="contact-title"
    data-testid="about-contact"
  >
    <div class="hh-container hh-contact">
      <div class="hh-contact__intro hh-stack-m">
        <p class="hh-eyebrow">Contact</p>
        <h2 id="contact-title">Try the enquiry form</h2>
        <p class="hh-lede">
          This working form demonstrates validation and confirmation. There is no person, phone
          number or inbox behind it.
        </p>
        <div class="hh-notice">
          <span>
            <strong>Nothing is sent.</strong> There is no server or inbox behind this form. What you
            type stays in the browser tab until you close it. Use made-up details only.
          </span>
        </div>
        <p class="hh-contact__aside">
          Do not enter payment details, identity documents or firearms-licensing information anywhere
          on this site.
        </p>
      </div>

      <form class="hh-form" data-testid="contact-form" novalidate>
        <h3 class="hh-form__title">Demonstration enquiry</h3>

        <div class="hh-field">
          <label class="hh-label" for="contact-name">
            Name <span class="hh-field__req">(required)</span>
          </label>
          <input
            class="hh-input"
            id="contact-name"
            name="name"
            type="text"
            autocomplete="name"
            required
          />
          <p class="hh-error" id="contact-name-error" data-testid="error-name" hidden></p>
        </div>

        <div class="hh-field">
          <label class="hh-label" for="contact-email">
            Email <span class="hh-field__req">(required)</span>
          </label>
          <input
            class="hh-input"
            id="contact-email"
            name="email"
            type="email"
            autocomplete="email"
            aria-describedby="contact-email-hint"
            required
          />
          <p class="hh-hint" id="contact-email-hint">
            Used only to demonstrate the field. It is never stored or sent.
          </p>
          <p class="hh-error" id="contact-email-error" data-testid="error-email" hidden></p>
        </div>

        <div class="hh-field">
          <label class="hh-label" for="contact-journey">Journey of interest</label>
          <select class="hh-select" id="contact-journey" name="journey">
            <option value="">Not sure yet</option>
            {tours.map((tour) => <option value={tour.slug}>{tour.name}</option>)}
            <option value="bespoke">Something bespoke</option>
          </select>
        </div>

        <div class="hh-field">
          <label class="hh-label" for="contact-message">
            Message <span class="hh-field__req">(required)</span>
          </label>
          <textarea class="hh-textarea" id="contact-message" name="message" required></textarea>
          <p class="hh-error" id="contact-message-error" data-testid="error-message" hidden></p>
        </div>

        <button class="hh-button" type="submit" data-testid="contact-submit">
          Send the demonstration enquiry
        </button>

        <div
          class="hh-form__success"
          role="status"
          tabindex="-1"
          data-testid="contact-success"
          hidden
        >
          <p class="hh-form__successtitle">Your message was not sent.</p>
          <p>
            The form validated and then stopped, because Harry&rsquo;s Hunts is a demonstration and
            there is nothing behind it to receive an enquiry. Nothing was transmitted and nothing was
            stored.
          </p>
        </div>
      </form>
    </div>
  </section>

  <!-- ------------------------------------------------------ demonstration -->
  <section
    class="hh-section"
    id="demonstration"
    aria-labelledby="demonstration-title"
    data-testid="about-demonstration"
  >
    <div class="hh-container">
      <header class="hh-sectionhead hh-reveal">
        <div>
          <p class="hh-eyebrow">How the demo works</p>
          <h2 id="demonstration-title">What is real and what is invented</h2>
        </div>
        <p class="hh-sectionhead__aside">
          The software works. The company does not exist.
        </p>
      </header>

      <div class="hh-realgrid hh-reveal">
        <div class="hh-real hh-real--yes">
          <h3 class="hh-real__title" id="real-heading">Real</h3>
          <ul aria-labelledby="real-heading">
            {
              whatIsReal.map((entry) => (
                <li>
                  <span class="hh-real__marker" aria-hidden="true">
                    &check;
                  </span>
                  <span>{entry}</span>
                </li>
              ))
            }
          </ul>
        </div>

        <div class="hh-real hh-real--no">
          <h3 class="hh-real__title" id="invented-heading">Invented</h3>
          <ul aria-labelledby="invented-heading">
            {
              whatIsInvented.map((entry) => (
                <li>
                  <span class="hh-real__marker" aria-hidden="true">
                    &ndash;
                  </span>
                  <span>{entry}</span>
                </li>
              ))
            }
          </ul>
        </div>
      </div>

      <div class="hh-demonote hh-reveal hh-stack-m">
        <h3>No booking or payment service exists</h3>
        <p>
          The planner produces a summary in your browser and stops. The store keeps its cart in local
          storage and ends at a demo confirmation. There is no payment provider, no working card
          field and no order, booking or enquiry.
        </p>
        <p>
          Nothing you type on this site is transmitted. It is a static build served as files, so
          there is no application server, no database and no inbox behind any of these forms.
        </p>
        <h3>Not advice, not an offer</h3>
        <p>
          Journey details about seasons, access, licensing, safety and game care are fictional
          editorial material. They are not legal or regulatory guidance. For a real trip, use the
          relevant New Zealand authorities and a qualified operator.
        </p>
      </div>
    </div>
  </section>

  <!-- ---------------------------------------------------- asset provenance -->
  <section
    class="hh-section hh-section--sunken"
    id="assets"
    aria-labelledby="assets-title"
    data-testid="about-assets"
  >
    <div class="hh-container">
      <header class="hh-sectionhead hh-reveal">
        <div>
          <p class="hh-eyebrow">Asset provenance</p>
          <h2 id="assets-title">How the pictures and mark were made</h2>
        </div>
        <p class="hh-sectionhead__aside">
          The project records where its visual material came from.
        </p>
      </header>

      <div class="hh-assets hh-reveal">
        <figure class="hh-assets__figure">
          <Image
            src={brandBoard}
            alt="Brand concept board for Harry's Hunts: monogram studies, an antler mark, colour chips in forest green, bone and brass, and type specimens."
            widths={[520, 900, 1402]}
            sizes="(min-width: 60rem) 30rem, 92vw"
            loading="lazy"
            decoding="async"
          />
          <figcaption>
            An AI-generated concept board used as visual reference. The production mark is original SVG,
            not a trace of the board.
          </figcaption>
        </figure>

        <div class="hh-assets__body hh-stack-m">
          <p>
            Three images were generated with AI for this project: a brand board, a wide South Island
            scene and a merchandise sheet. None depicts a real place, product or person.
          </p>
          <p>
            The remaining raster images are reproducible crops of those sources, produced by
            <code>scripts/derive-images.mjs</code>, which reads the boards, extracts a named region
            for each asset and writes it into the repository.
          </p>
          <p>
            The mark and lockup are original code-native SVG in
            <code>src/components/BrandMark.astro</code>. The same geometry is used from favicon to
            large lockup without a raster logo in between.
          </p>
          <p>
            No photograph of a real hunt, animal or guest appears on the site. Harry&rsquo;s Hunts,
            its mark and every journey were invented for this project and are not presented as a
            real operator.
          </p>
        </div>
      </div>
    </div>
  </section>
</Base>

<script>
  /*
   * The contact form is a demonstration of the interaction, not a transport. It
   * validates in the browser, reports errors against each control, and then
   * explicitly tells the visitor that nothing was sent.
   */
  const form = document.querySelector<HTMLFormElement>('[data-testid="contact-form"]');
  const success = document.querySelector<HTMLElement>('[data-testid="contact-success"]');

  if (form && success) {
    type Control = HTMLInputElement | HTMLTextAreaElement;

    const rules: { name: string; check: (value: string) => string | null }[] = [
      {
        name: 'name',
        check: (value) => (value.trim() ? null : 'Enter the name we should use.'),
      },
      {
        name: 'email',
        check: (value) => {
          if (!value.trim()) return 'Enter an email address.';
          return /^[^\s@]+@[^\s@]+\.[^\s@]+$/.test(value.trim())
            ? null
            : 'Enter an email address in the form name@example.com.';
        },
      },
      {
        name: 'message',
        check: (value) =>
          value.trim().length >= 10
            ? null
            : 'Write at least a sentence so the demonstration has something to validate.',
      },
    ];

    interface Field {
      control: Control;
      error: HTMLElement;
      /** Ids the control described itself with before any error was added. */
      described: string | null;
      check: (value: string) => string | null;
    }

    const fields: Field[] = [];
    for (const rule of rules) {
      const control = form.elements.namedItem(rule.name) as Control | null;
      const error = form.querySelector<HTMLElement>(`[data-testid="error-${rule.name}"]`);
      if (!control || !error) continue;
      fields.push({
        control,
        error,
        described: control.getAttribute('aria-describedby'),
        check: rule.check,
      });
    }

    const report = (field: Field, message: string | null) => {
      const ids = field.described ? field.described.split(/\s+/) : [];
      if (message) {
        field.control.setAttribute('aria-invalid', 'true');
        field.error.textContent = message;
        field.error.hidden = false;
        ids.push(field.error.id);
      } else {
        field.control.removeAttribute('aria-invalid');
        field.error.textContent = '';
        field.error.hidden = true;
      }
      if (ids.length) field.control.setAttribute('aria-describedby', ids.join(' '));
      else field.control.removeAttribute('aria-describedby');
    };

    let submitted = false;

    const validate = () => {
      const failures = fields.filter((field) => {
        const message = field.check(field.control.value);
        report(field, message);
        return message !== null;
      });
      return failures;
    };

    for (const field of fields) {
      field.control.addEventListener('input', () => {
        if (!submitted) return;
        report(field, field.check(field.control.value));
      });
    }

    form.addEventListener('submit', (event) => {
      event.preventDefault();
      submitted = true;
      success.hidden = true;

      const failures = validate();
      if (failures.length) {
        failures[0].control.focus();
        return;
      }

      success.hidden = false;
      success.focus();
    });
  }
</script>

<style>
  /* ------------------------------------------------------------ page head */
  .hh-pagehead {
    display: grid;
    gap: var(--hh-space-l);
    align-items: start;
  }

  .hh-pagehead__lead h1 {
    max-width: 20ch;
  }

  .hh-pagehead__lead p:not(.hh-lede) {
    max-width: var(--hh-measure);
    color: var(--hh-ink-muted);
  }

  .hh-pagehead__lead .hh-lede {
    max-width: 54ch;
  }

  @media (min-width: 60rem) {
    .hh-pagehead {
      grid-template-columns: minmax(0, 1.7fr) minmax(0, 1fr);
      gap: var(--hh-space-3xl);
    }
  }

  /* ------------------------------------------------------ table of contents */
  .hh-toc {
    padding: var(--hh-space-m);
    background: var(--hh-surface-sunken);
    border-left: 3px solid var(--hh-brass-500);
    border-radius: 0 var(--hh-radius-m) var(--hh-radius-m) 0;
  }

  .hh-toc__title {
    font-family: var(--hh-font-body);
    font-size: var(--hh-step--2);
    font-weight: 600;
    letter-spacing: var(--hh-tracking-eyebrow);
    text-transform: uppercase;
    color: var(--hh-ink-accent);
    margin-bottom: var(--hh-space-s);
  }

  .hh-toc ul {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
  }

  .hh-toc li + li {
    border-top: 1px solid var(--hh-line);
  }

  .hh-toc a {
    display: block;
    padding-block: 0.55rem;
    font-size: var(--hh-step--1);
    text-decoration: none;
    color: var(--hh-ink-brand);
  }

  .hh-toc a:hover {
    color: var(--hh-ink-accent);
    text-decoration: underline;
    text-underline-offset: 3px;
  }

  /* --------------------------------------------------------- section head */
  .hh-sectionhead {
    display: grid;
    gap: var(--hh-space-s);
    align-items: end;
    margin-bottom: var(--hh-space-xl);
  }

  .hh-sectionhead > div > h2 {
    margin-top: var(--hh-space-2xs);
  }

  .hh-sectionhead__aside {
    font-size: var(--hh-step--1);
    color: var(--hh-ink-muted);
    max-width: 42ch;
  }

  @media (min-width: 56rem) {
    .hh-sectionhead {
      grid-template-columns: minmax(0, 1.4fr) minmax(0, 1fr);
      gap: var(--hh-space-2xl);
    }

    .hh-sectionhead__aside {
      justify-self: end;
      text-align: right;
    }
  }

  /* --------------------------------------------------------------- values */
  .hh-valuegrid {
    display: grid;
    gap: var(--hh-space-m);
    grid-template-columns: repeat(auto-fit, minmax(min(18rem, 100%), 1fr));
  }

  .hh-valuecard {
    padding: var(--hh-space-m);
    background: var(--hh-surface-raised);
    border: 1px solid var(--hh-line);
    border-top: 2px solid var(--hh-forest-800);
    border-radius: var(--hh-radius-m);
  }

  .hh-valuecard__title {
    font-size: var(--hh-step-1);
    margin-bottom: var(--hh-space-2xs);
  }

  .hh-valuecard__body {
    font-size: var(--hh-step--1);
    color: var(--hh-ink-muted);
  }

  /* --------------------------------------------------------------- guides */
  .hh-guides {
    display: grid;
    gap: var(--hh-space-xl);
    align-items: start;
  }

  @media (min-width: 60rem) {
    .hh-guides {
      grid-template-columns: minmax(0, 26rem) minmax(0, 1fr);
      gap: var(--hh-space-3xl);
    }

    .hh-guides__figure {
      position: sticky;
      top: 6rem;
    }
  }

  .hh-guides__figure {
    margin: 0;
  }

  .hh-guides__figure :global(img) {
    width: 100%;
    height: auto;
    border-radius: var(--hh-radius-m);
    border: 1px solid var(--hh-line);
  }

  .hh-guides__figure figcaption {
    margin-top: var(--hh-space-xs);
    font-size: var(--hh-step--2);
    color: var(--hh-ink-subtle);
  }

  .hh-guides__body {
    max-width: var(--hh-measure);
    color: var(--hh-ink-muted);
  }

  .hh-guides__body h3 {
    font-size: var(--hh-step-2);
    color: var(--hh-ink-brand);
  }

  .hh-guides__body h3:not(:first-child) {
    margin-top: var(--hh-space-l);
    padding-top: var(--hh-space-m);
    border-top: 1px solid var(--hh-line);
  }

  /* -------------------------------------------------------------- contact */
  .hh-contact {
    display: grid;
    gap: var(--hh-space-xl);
    align-items: start;
  }

  @media (min-width: 60rem) {
    .hh-contact {
      grid-template-columns: minmax(0, 1fr) minmax(0, 27rem);
      gap: var(--hh-space-3xl);
    }
  }

  .hh-contact__intro h2 {
    max-width: 18ch;
  }

  .hh-contact__intro .hh-lede {
    max-width: 46ch;
  }

  .hh-contact__aside {
    font-size: var(--hh-step--1);
    color: var(--hh-ink-muted);
    max-width: 46ch;
  }

  .hh-form {
    display: grid;
    gap: var(--hh-space-m);
    padding: var(--hh-space-l);
    background: var(--hh-surface-raised);
    border: 1px solid var(--hh-line);
    border-top: 3px solid var(--hh-forest-800);
    border-radius: var(--hh-radius-m);
    box-shadow: var(--hh-shadow-s);
  }

  .hh-form__title {
    font-size: var(--hh-step-2);
  }

  .hh-field__req {
    font-weight: 400;
    letter-spacing: 0;
    text-transform: none;
    color: var(--hh-ink-subtle);
  }

  .hh-error[hidden] {
    display: none;
  }

  .hh-form__success {
    padding: var(--hh-space-m);
    border: 1px solid var(--hh-forest-600);
    border-left: 3px solid var(--hh-forest-600);
    border-radius: var(--hh-radius-s);
    background: color-mix(in srgb, var(--hh-forest-600) 8%, transparent);
    font-size: var(--hh-step--1);
    color: var(--hh-ink-muted);
  }

  .hh-form__success[hidden] {
    display: none;
  }

