---
/**
 * Full cart view. The shell, page head and thumbnails are rendered on the
 * server; everything interactive lives in the CartPage island because the cart
 * itself only exists in the visitor's browser.
 */
import Base from '../../layouts/Base.astro';
import CartPage from '../../components/CartPage.tsx';
import { productThumbs } from '../../lib/thumbs';

const thumbs = await productThumbs(220);
---

<Base
  title="Cart"
  description="Review the fictional Harry's Hunts field kit in a browser-only demonstration cart. Nothing is reserved, charged or sent."
  pageId="cart"
  padTop={false}
>
  <section class="hh-section hh-section--tight" aria-labelledby="cart-title">
    <div class="hh-container">
      <header class="hh-pagehead">
        <p class="hh-eyebrow">The field kit</p>
        <h1 id="cart-title">Your cart</h1>
        <p class="hh-lede">
          Change quantities and try the indicative delivery estimate. The cart is a demonstration:
          it stays in this browser and creates no order.
        </p>
      </header>

      <CartPage client:load thumbs={thumbs} />
    </div>
  </section>
</Base>

<style>
  .hh-pagehead {
    max-width: 46rem;
    margin-bottom: var(--hh-space-xl);
  }

  .hh-pagehead h1 {
    margin-block: var(--hh-space-2xs) var(--hh-space-s);
  }
</style>
