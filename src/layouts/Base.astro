---
import '../styles/global.css';
import DemoBar from '../components/DemoBar.astro';
import SiteHeader from '../components/SiteHeader.astro';
import SiteFooter from '../components/SiteFooter.astro';
import CartDrawer from '../components/CartDrawer.tsx';
import { href } from '../lib/paths';
import { productThumbs } from '../lib/thumbs';

interface Props {
  title: string;
  description: string;
  /** Adds a `hh-page--<slug>` hook and is exposed for tests. */
  pageId?: string;
  /** Set false on pages that render their own hero flush under the header. */
  padTop?: boolean;
}

const { title, description, pageId, padTop = true } = Astro.props;

// `title` is plain text: it lands in <title> and in meta content, where HTML
// entities would be shown literally.
const fullTitle = title.includes("Harry's Hunts") ? title : `${title} · Harry's Hunts`;
const canonical = new URL(Astro.url.pathname, Astro.site ?? 'https://example.invalid');
const ogImage = new URL(`${import.meta.env.BASE_URL}og-image.jpg`, canonical);

const thumbs = await productThumbs();
---

<!doctype html>
<html lang="en-NZ">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{fullTitle}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical.href} />

    <link rel="icon" href={href('/favicon.svg')} type="image/svg+xml" />
    <link rel="apple-touch-icon" href={href('/apple-touch-icon.png')} />
    <meta name="theme-color" content="#16311f" />

    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="Harry's Hunts" />
    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical.href} />
    <meta property="og:image" content={ogImage.href} />
    <meta name="twitter:card" content="summary_large_image" />

    <meta name="robots" content="index, follow" />
    <meta name="generator" content={Astro.generator} />

    <script is:inline>
      // Opt in to the scroll reveal only when we can actually drive it. Without
      // this flag the CSS keeps every section visible, so no-JS and
      // reduced-motion visitors never see a blank page.
      if (
        'IntersectionObserver' in window &&
        !window.matchMedia('(prefers-reduced-motion: reduce)').matches
      ) {
        document.documentElement.dataset.reveal = 'on';
      }
    </script>
  </head>

  <body class:list={[pageId && `hh-page--${pageId}`]} data-page={pageId}>
    <a class="hh-skip-link" href="#main">Skip to content</a>
    <div class="hh-shell">
      <DemoBar />
      <SiteHeader />
      <main id="main" class:list={[padTop && 'hh-main--pad']} tabindex="-1">
        <slot />
      </main>
      <SiteFooter />
    </div>
    <CartDrawer client:idle thumbs={thumbs} />

    <script>
      // Progressive reveal for `.hh-reveal` sections. Reduced-motion users get the
      // final state immediately via CSS, so we simply mark everything visible.
      const reduced = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
      const targets = document.querySelectorAll<HTMLElement>('.hh-reveal');

      if (reduced || !('IntersectionObserver' in window)) {
        targets.forEach((element) => element.classList.add('is-visible'));
      } else {
        const observer = new IntersectionObserver(
          (entries) => {
            entries.forEach((entry) => {
              if (!entry.isIntersecting) return;
              entry.target.classList.add('is-visible');
              observer.unobserve(entry.target);
            });
          },
          { rootMargin: '0px 0px -12% 0px', threshold: 0.05 },
        );
        targets.forEach((element) => observer.observe(element));
      }
    </script>

    <style is:global>
      .hh-main--pad {
        padding-top: var(--hh-space-xl);
      }

      main:focus {
        outline: none;
      }
    </style>
  </body>
</html>
